rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Personal Profile (Data Identitas Diri Muhammad)
    match /personal_profile/{docId} {
      allow read, write: if true;
    }

    // 2. Personal Documents (KTP, KK, Ijazah, SIM, NPWP, Akta, dll.)
    match /personal_documents/{docId} {
      allow read, write: if true;
    }

    // 3. User Authentication
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

  }
}
