rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Users collection (Manajemen Admin)
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 2. Profile collection (Publik bisa baca, Hanya Admin yang bisa ubah)
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. Settings collection (Publik bisa baca, Hanya Admin yang bisa ubah)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 4. Skills collection (Publik bisa baca, Hanya Admin yang bisa ubah)
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 5. Projects collection (Publik bisa baca, Hanya Admin yang bisa ubah)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 6. Blog collection (Publik baca artikel published, Admin kelola semua)
    match /blog/{blogId} {
      allow read: if resource.data.status == 'published' || isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 7. Social Links collection (Publik bisa baca, Hanya Admin yang bisa ubah)
    match /socialLinks/{linkId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 8. Education collection (Publik bisa baca, Hanya Admin yang bisa ubah)
    match /education/{eduId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 9. Experiences collection (Publik bisa baca, Hanya Admin yang bisa ubah)
    match /experiences/{expId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 10. Messages collection (Publik kirim pesan tervalidasi, Hanya Admin yang baca)
    match /messages/{messageId} {
      allow read, delete, update: if isAuthenticated();
      
      allow create: if 
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.size() <= 150 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 5000 &&
        request.resource.data.isRead == false;
    }

  }
}
